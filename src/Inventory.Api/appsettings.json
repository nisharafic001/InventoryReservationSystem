{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ],
    "Properties": { "Application": "Inventory.Api" }
  },
  "AllowedHosts": "*",
  "Database": {
    "ServerVersion": "8.0.41-mysql"
  },
  "Jwt": {
    "Issuer": "inventory-api",
    "Audience": "inventory-clients",
    "ExpirationMinutes": 60
  },
  "RateLimiting": {
    "General": { "PermitLimit": 600, "Window": "00:01:00" },
    "Login": { "PermitLimit": 10, "Window": "00:01:00" },
    "Reservations": { "TokenLimit": 60, "TokensPerPeriod": 30, "ReplenishmentPeriod": "00:00:10" }
  },
  "ReservationExpiry": {
    "Enabled": true,
    "PollingInterval": "00:00:15",
    "BatchSize": 100
  }
}
