{
  "info": {
    "name": "Inventory Reservation API",
    "description": "End-to-end checks for the Inventory Reservation System.\n\n1. Start the stack: `docker compose up --build` (API on http://localhost:8080).\n2. Set the collection variables `username` / `password` to DEMO_ADMIN_USERNAME / DEMO_ADMIN_PASSWORD from `.env` (or select the bundled environment and edit it there).\n3. Run the folders 1 → 4 in order with the Collection Runner. Each request stores what the next one needs (token, product id, reservation id) and asserts the expected status and errorCode.\n4. Folder 5 (expiry) is optional: it waits for the 2-minute reservation lifetime, so run it on its own.\n\nAuthentication: collection-level Bearer token `{{token}}`, set automatically by the login request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "change-me"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "sku",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "cancelReservationId",
      "value": ""
    },
    {
      "key": "expiringReservationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health & Auth",
      "item": [
        {
          "name": "Health (liveness)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correlation id header\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Health (readiness: database reachable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login with wrong password → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"ProblemDetails with errorCode INVALID_CREDENTIALS\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "  pm.expect(body.errorCode).to.eql(\"INVALID_CREDENTIALS\");",
                  "  pm.expect(body.correlationId, \"correlationId\").to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login → JWT (stores {{token}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Bearer token returned\", () => { pm.expect(body.tokenType).to.eql(\"Bearer\"); pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"token\", body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Uses the collection variables `username` and `password`. On success the access token is saved to `{{token}}` and used by every later request."
          },
          "response": []
        },
        {
          "name": "Protected endpoint without token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"ProblemDetails with errorCode UNAUTHORIZED\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "  pm.expect(body.errorCode).to.eql(\"UNAUTHORIZED\");",
                  "  pm.expect(body.correlationId, \"correlationId\").to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/00000000-0000-0000-0000-000000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "00000000-0000-0000-0000-000000000001"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Create product (stock 3) → 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"sku\", \"DEMO-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test(\"New product has full stock available\", () => { pm.expect(p.totalQuantity).to.eql(3); pm.expect(p.reservedQuantity).to.eql(0); pm.expect(p.soldQuantity).to.eql(0); pm.expect(p.availableQuantity).to.eql(3); });",
                  "pm.test(\"Location header points to the product\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(p.id));",
                  "pm.collectionVariables.set(\"productId\", p.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Demo Phone\",\n  \"totalQuantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Admin only. A unique SKU is generated before each run."
          },
          "response": []
        },
