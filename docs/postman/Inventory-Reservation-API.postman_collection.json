    {
      "name": "3. Reserve & confirm",
      "item": [
        {
          "name": "Reserve 2 → 201 Active (expires in 2 min)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Active, expires 2 minutes after creation\", () => { pm.expect(r.status).to.eql(\"Active\"); pm.expect(new Date(r.expiresAtUtc) - new Date(r.createdAtUtc)).to.eql(120000); });",
