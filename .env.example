# Copy to .env and set real values. .env is gitignored and excluded from the Docker build context.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# API
API_PORT=8080
# Random secret, at least 32 bytes, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-random-secret-of-at-least-32-bytes
# Optional bootstrap admin (leave the password empty to seed nobody)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me
# Swagger UI at /swagger: true for local review; leave unset or false in production (compose default: off)
SWAGGER_ENABLED=true
